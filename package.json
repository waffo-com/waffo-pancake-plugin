{
  "name": "@waffo-pancake/openclaw-plugin",
  "version": "0.3.2",
  "description": "OpenClaw plugin for Pancake payment webhook events",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "bin": {
    "pancake-setup": "./bin/setup.mjs",
    "waffo-pancake": "./bin/setup.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "pancake",
    "webhook",
    "payment"
  ],
  "author": "Waffo Team",
  "license": "MIT",
  "dependencies": {
    "cloudflared": "^0.6.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.1.0",
    "@types/node": "^22.0.0"
  }
}
