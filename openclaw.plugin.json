{
  "id": "@waffo/pancake",
  "name": "Pancake Webhook",
  "description": "接收 Pancake 支付事件，触发 OpenClaw Agent 自动通知与交付",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": ["test", "prod"],
        "default": "test",
        "description": "Pancake environment mode"
      },
      "logLevel": {
        "type": "string",
        "enum": ["debug", "info", "warn", "error"],
        "default": "info"
      },
      "tunnel": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "Auto-start Cloudflare Tunnel for local deployments"
          },
          "type": {
            "type": "string",
            "enum": ["quick", "named"],
            "default": "quick",
            "description": "quick = free random URL (dev/test), named = stable custom domain (prod)"
          },
          "namedTunnelToken": {
            "type": "string",
            "description": "Cloudflare Tunnel token (required for type=named)",
            "sensitive": true
          },
          "port": {
            "type": "number",
            "default": 18789,
            "description": "Local OpenClaw gateway port"
          }
        }
      }
    }
  }
}
